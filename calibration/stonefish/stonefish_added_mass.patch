+void SolidEntity::SetAddedMass(const Vector3& m, const Vector3& I, bool anisotropic)
+{
+    //Given along the body's own (O) axes; rotate the diagonal tensors to the CG frame used by the dynamics
+    Matrix3 R = T_CG2O.getBasis();
+    Matrix3 Am = R * Matrix3(m.x(), 0, 0, 0, m.y(), 0, 0, 0, m.z()) * R.transpose();
+    Matrix3 AI = R * Matrix3(I.x(), 0, 0, 0, I.y(), 0, 0, 0, I.z()) * R.transpose();
+    aMass = Vector3(btFabs(Am[0][0]), btFabs(Am[1][1]), btFabs(Am[2][2]));
+    aI = Vector3(btFabs(AI[0][0]), btFabs(AI[1][1]), btFabs(AI[2][2]));
+    aMassAniso = anisotropic ? m : V0(); //kept along the body's own (O) axes
+    aniPrevValid = false;
+}
+
+void SolidEntity::ResetAddedMassState()
+{
+    aniPrevValid = false;
+}
+
+Vector3 SolidEntity::getAnisotropicAddedMass() const
+{
+    return aMassAniso;
+}
+
+void SolidEntity::SetAxisDamping(const Vector3& linear, const Vector3& linearRot, const Vector3& quadratic,
+                                 const Vector3& quadraticRot, const Vector3& point)
+{
+    dLin = linear;
+    dLinRot = linearRot;
+    dQuad = quadratic;
+    dQuadRot = quadraticRot;
+    dPoint = point;
+    axisDamping = true;
+}
+
+bool SolidEntity::hasAxisDamping() const
+{
+    return axisDamping;
+}
+
+void SolidEntity::ComputeAxisDamping(Ocean* ocn, const Transform& T_O, const Vector3& cg, const Vector3& v,
+                                     const Vector3& omega, Vector3& F, Vector3& T) const
+{
+    Matrix3 R = T_O.getBasis();
+    Vector3 p = T_O * dPoint; //the damping point, world frame
+    Vector3 vp = v + omega.cross(p - cg); //its velocity
+    if(ocn != nullptr) //relative to the water
+    {
+        glm::vec3 fv = ocn->GetFluidVelocity(glm::vec3((GLfloat)p.x(), (GLfloat)p.y(), (GLfloat)p.z()));
+        vp -= Vector3(fv.x, fv.y, fv.z);
+    }
+    Vector3 vB = R.transpose() * vp;
+    Vector3 wB = R.transpose() * omega;
+    Vector3 FB((dLin.x() + dQuad.x() * btFabs(vB.x())) * vB.x(),
+               (dLin.y() + dQuad.y() * btFabs(vB.y())) * vB.y(),
+               (dLin.z() + dQuad.z() * btFabs(vB.z())) * vB.z());
+    Vector3 MB((dLinRot.x() + dQuadRot.x() * btFabs(wB.x())) * wB.x(),
+               (dLinRot.y() + dQuadRot.y() * btFabs(wB.y())) * wB.y(),
+               (dLinRot.z() + dQuadRot.z() * btFabs(wB.z())) * wB.z());
+    F = R * FB;
+    T = R * MB + (p - cg).cross(F); //the force acts at the damping point: its moment about the CG
+}
+
 void SolidEntity::ApplyHydrodynamicForces()
 {
-    ApplyCentralForce(Fb + Fdq + Fdf);
-    ApplyTorque(Tb + Tdq + Tdf);
+    Vector3 F = Fb + Fdq + Fdf;
+    Vector3 T = Tb + Tdq + Tdf;
+
+    //Anisotropic added mass: the multibody solver carries one (mean) added mass in all directions; apply the per-axis
+    //difference D = A - mean as forces, F = -D*dv/dt - w x (D*v), plus the Munk moment T = -v x (D*v) (body frame).
+    if(!btFuzzyZero(aMassAniso.length2()))
+    {
+        Matrix3 R = getOTransform().getBasis(); //the body's own axes, in which aMassAniso is given
+        Vector3 vW = getLinearVelocity();
+        Vector3 wB = R.transpose() * getAngularVelocity();
+        Vector3 vB = R.transpose() * vW;
+        Scalar dt = Scalar(1) / SimulationApp::getApp()->getSimulationManager()->getStepsPerSecond();
+        Vector3 aW = aniPrevValid ? (vW - aniPrevV) / dt : V0();
+        aniPrevV = vW;
+        aniPrevValid = true;
+        Scalar mean = getAugmentedMass() - mass;
+        Scalar lim = Scalar(0.8) * getAugmentedMass(); //keeps the explicit correction stable
+        Vector3 D(btClamped(aMassAniso.x() - mean, -lim, lim), btClamped(aMassAniso.y() - mean, -lim, lim),
+                  btClamped(aMassAniso.z() - mean, -lim, lim));
+        Vector3 vdotB = R.transpose() * aW - wB.cross(vB);
+        Vector3 Dv(D.x() * vB.x(), D.y() * vB.y(), D.z() * vB.z());
+        Vector3 Fc = -Vector3(D.x() * vdotB.x(), D.y() * vdotB.y(), D.z() * vdotB.z()) - wB.cross(Dv);
+        Vector3 Tc = -vB.cross(Dv);
+        F += R * Fc;
+        T += R * Tc;
+    }
+    ApplyCentralForce(F);
+    ApplyTorque(T);
 }
 
